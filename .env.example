# Wine Tracker - environment variables for the Docker standalone deployment.
# Copy to .env, adjust, then reference it from docker-compose.yml:
#   env_file: .env
#
# Home Assistant add-on users configure everything on the add-on
# configuration page instead - these variables are the Docker equivalent
# and override values coming from options.json.
# Note: AI settings saved in the app (Settings -> AI) win over both.

# ── Authentication ────────────────────────────────────────────────────────
# Login is off by default. Enable it for any installation reachable
# from outside localhost.
AUTH_ENABLED=true

# User list, comma-separated. Each entry is user:password (full access)
# or user:password:readonly (browse and search only).
USERS=admin:changeme

# Session encryption key. A random key is generated on every start, so
# set a fixed value here to keep logins across restarts.
SECRET_KEY=change-this-to-a-random-string

# ── General ───────────────────────────────────────────────────────────────
# Currency for prices (also the currency the web lookup asks for), e.g.
# CHF, EUR, USD, GBP, CAD, AUD, SEK, NOK, DKK, PLN, CZK, BRL.
CURRENCY=CHF

# UI language: de, en, fr, it, es, pt, nl
LANGUAGE=de

# ── AI provider (optional, pick one) ──────────────────────────────────────
# Drives label recognition, maturity/taste/food enrichment and the
# sommelier chat. Values: none, anthropic, openai, openrouter, ollama,
# minimax, mistral
AI_PROVIDER=none

# Anthropic (Claude) - key from console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# Web lookup (replaces the Vivino search). Only available with
# AI_PROVIDER=anthropic. Each lookup is a paid Anthropic web search
# (billed per search plus tokens), so it is capped per user per day.
# LOOKUP_DAILY_CAP=30
# LOOKUP_MAX_SEARCHES=3
# LOOKUP_TIMEOUT_SECONDS=90
# LOOKUP_MODEL=claude-haiku-5-5

# OpenAI (GPT) - key from platform.openai.com
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5

# OpenRouter (routes to many models) - key from openrouter.ai
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-opus-4.8

# Ollama (fully local, no API key). From inside a container the host is
# not localhost - use host.docker.internal or the Ollama container name.
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2-vision

# MiniMax - key from platform.minimaxi.com
# MINIMAX_API_KEY=...
# MINIMAX_MODEL=MiniMax-M3

# Mistral - key from console.mistral.ai. Label recognition needs a
# vision-capable (Pixtral) model.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-medium-latest

# Separate model for the sommelier chat only. Empty means the chat uses
# the same model as label recognition - useful to pair a cheap vision
# model with a stronger chat model on the same provider.
# CHAT_MODEL=

# ── Paths (rarely needed) ─────────────────────────────────────────────────
# Where the SQLite database and uploaded images live. The Docker image
# presets /data/wine-tracker, the add-on uses /share/wine-tracker.
# DATA_DIR=/data/wine-tracker

# Home Assistant add-on options file. Only relevant when running the app
# outside the add-on and pointing it at a local options.json.
# OPTIONS_PATH=/data/options.json

# ── Development only ──────────────────────────────────────────────────────
# Shortcut that enables auth and creates a single user in one go:
# user:password or user:password:role. Never use in production.
# DEV_AUTH=admin:pass
