[Unit]
Description=Wine Tracker nightly backup to Cloudflare R2 (restic)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=WT_ROOT=/opt/nursestar/wine-tracker
ExecStart=/opt/nursestar/wine-tracker/deploy/nursestar/ops/backup.sh
Nice=10
IOSchedulingClass=idle
