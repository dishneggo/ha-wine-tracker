# Wine Tracker hosted environment for the NurseStar VPS.
# Copy to /opt/nursestar/wine-tracker/.env on the server, owner root:root,
# mode 0600. Never commit the real file. See DEPLOY.md for how to write
# secret values without echoing them.

# General
CURRENCY=USD
LANGUAGE=en

# Login (required for a public host). HOSTED_MODE refuses to start with
# auth off, a weak SECRET_KEY, no users, or DEV_AUTH set.
HOSTED_MODE=1
AUTH_ENABLED=true
# 64 hex chars: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Hashed users, mounted read-only by compose. See DEPLOY.md section 2.
USERS_FILE=/run/secrets/users.json
# Login lifetime in days (hosted mode)
SESSION_DAYS=14
# Request body cap in MB, same as nginx client_max_body_size
MAX_UPLOAD_MB=20

# Behind host nginx (one proxy hop). nginx overwrites X-Forwarded-For with
# the visitor IP from CF-Connecting-IP, so login throttling sees real IPs.
TRUST_PROXY=1
# Cross-site POST/PUT/DELETE are refused unless Origin/Referer match this.
PUBLIC_ORIGIN=https://wine.clearnuvo.com
# These default to on in HOSTED_MODE; listed so the intent is explicit.
CSRF_ENABLED=1
UPLOADS_REQUIRE_AUTH=1
LOCK_AI_SETTINGS=1
TRUST_INGRESS_HEADER=0
# Login throttle: failures per IP+user, per IP, and window in seconds
LOGIN_MAX_FAILS=5
LOGIN_MAX_FAILS_PER_IP=20
LOGIN_WINDOW_SECONDS=900

# AI provider for label recognition
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
