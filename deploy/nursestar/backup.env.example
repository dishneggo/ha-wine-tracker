# Copy to /root/.config/wine-backup.env on the server, root:root 0600.
# Values come from the R2 API token scoped to the wine-tracker-backups bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/wine-tracker-backups
RESTIC_REPOSITORY=
# Long random string. Keep a copy in Diego's password manager: without it
# the backups cannot be decrypted.
RESTIC_PASSWORD=
